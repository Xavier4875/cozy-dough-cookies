# Server-side config for the production backend. On the instance this becomes
# /opt/cozy-dough/backend.env (create it there yourself, e.g. `sudo nano`, and
# paste the secrets in — it is never part of the deploy bundle).
#
# Deliberately absent: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# DYNAMODB_ENDPOINT. On EC2 the instance's IAM role supplies AWS credentials and
# the real DynamoDB is the default; setting any of these would override that.
# TRUST_PROXY_HOPS is set by docker-compose.yml.

PORT=4000

# AWS (DynamoDB + SES) — the region the tables and the verified SES sender are in.
AWS_REGION=us-east-2

# Stripe. Start with the TEST secret key (sk_test_...) and the signing secret of
# the test-mode webhook endpoint; swap both for live values at go-live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cognito — the LIVE pool (cozy-dough-pool-prod). Must be the same pool the
# frontend is built against (frontend/.env.production's VITE_COGNITO_* values).
# The test pool, cozy-dough-pool, is only for local development.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-2

# DynamoDB tables — the LIVE set (the "-Prod" tables). The code's defaults
# (CozyDoughOrders etc., no suffix) are the TEST tables used by local dev, so
# these four must always be set on the server; the instance's IAM role can only
# reach the -Prod tables, which makes a missed line fail loudly instead of
# quietly writing real orders to test data.
CUSTOMERS_TABLE_NAME=CozyDoughCustomers-Prod
ORDERS_TABLE_NAME=CozyDoughOrders-Prod
EXTERNAL_SALES_TABLE_NAME=CozyDoughExternalSales-Prod
EMAIL_VERIFICATIONS_TABLE_NAME=CozyDoughEmailVerifications-Prod

# USPS address validation (leave both blank to accept addresses as typed)
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=
USPS_API_BASE_URL=https://apis.usps.com

# SES sender (an address on a verified identity in AWS_REGION — the domain
# cozydoughcookies.com is verified, so orders@cozydoughcookies.com works) and the
# inboxes that get new-order emails and payment alerts (comma-separated for
# several).
SES_SENDER_EMAIL=
STAFF_NOTIFICATION_EMAIL=
# Optional: where customers' replies go (the sender above has no inbox).
# SES_REPLY_TO_EMAIL=

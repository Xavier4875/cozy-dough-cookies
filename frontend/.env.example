# Filled in during Cognito setup — same User Pool/App Client as backend/.env
VITE_COGNITO_USER_POOL_ID=us-east-1_replace_me
VITE_COGNITO_CLIENT_ID=replace_me
VITE_COGNITO_REGION=us-east-1

# Stripe's publishable key is safe to expose client-side (unlike the secret
# key, which only ever lives in backend/.env) — same Stripe account/mode
# (test vs live) as backend/.env's STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
